+    InkOrdinate  TriggerDarkGround  = Covering(ControlDarkGround);        // [-] - the dark 64 px trigger
+    InkOrdinate  TriggerDarkInk     = Covering(ControlLightGround);       // [-] - the figure inside it
+};
